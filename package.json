{
  "name": "brandons-ball-buster",
  "productName": "Brandon's Ball Buster",
  "version": "2.0.0",
  "description": "A candy-coated falling-ball puzzle game. Stack the berries and bust the lines.",
  "main": "electron/main.js",
  "author": "Brandon",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.brandon.ballbuster",
    "productName": "Brandon's Ball Buster",
    "copyright": "Copyright © 2026 Brandon",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "game.js",
      "assets/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Brandons-Ball-Buster-${version}.exe"
    },
    "portable": {
      "artifactName": "Brandons-Ball-Buster-${version}.exe"
    }
  }
}
